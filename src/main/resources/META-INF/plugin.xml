<idea-plugin>
    <id>dev.xdark.ij-mcp</id>
    <name>Extended MCP</name>
    <vendor>xdark</vendor>
    <description>Extends the built-in JetBrains MCP server with additional tools: find_usages, apply_quick_fix, optimize_imports.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.FindUsagesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.QuickFixToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ExtendedRefactoringToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.ImplementationsToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.TypeInfoToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ExtractMethodToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.LibrarySourcesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.GoToDeclarationToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.FileStructureToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.FindClassToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.build.GradleToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.MoveClassToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ChangeSignatureToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.SafeDeleteToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.InlineToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.ListPackageClassesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.AddMethodToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.AddFieldToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.AddImportToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.docs.AddDocumentationToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.docs.GetDocumentationToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.docs.MissingDocumentationToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ReplaceMethodBodyToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.nav.FindInFilesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.BatchProblemsToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.BatchFileTextToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.CreateFileToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.RenameMemberToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.build.GradleSyncToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ShortenReferencesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.refactor.ReformatToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.ReplaceLinesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.BatchReplaceLinesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.build.DownloadSourcesToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.tools.files.BatchReplaceTextToolset"/>
        <mcpServer.mcpToolset implementation="dev.xdark.ijmcp.infra.ToolFilterToolset"/>
        <mcpServer.mcpToolFilterProvider implementation="dev.xdark.ijmcp.infra.ArgNormalizingFilterProvider"/>
        <applicationConfigurable parentId="tools"
                                 id="dev.xdark.ijmcp.settings"
                                 displayName="MCP Toolset Settings"
                                 instance="dev.xdark.ijmcp.settings.McpToolSettingsConfigurable"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.xdark.ijmcp.infra.McpMetricsListener"
                  topic="com.intellij.mcpserver.ToolCallListener"/>
    </applicationListeners>

    <actions>
        <action id="dev.xdark.ijmcp.infra.McpMetricsAction"
                class="dev.xdark.ijmcp.infra.McpMetricsAction"
                text="MCP Tool Metrics"
                description="View MCP tool usage statistics">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="dev.xdark.ijmcp.infra.ToolFilterAction"
                class="dev.xdark.ijmcp.infra.ToolFilterAction"
                text="MCP Tool Filter"
                description="Enable or disable MCP tools">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
